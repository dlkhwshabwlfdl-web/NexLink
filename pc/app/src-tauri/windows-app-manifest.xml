<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- NexLink Windows application manifest (backlog item 3).

     Based on tauri-build's default manifest (Common Controls v6), plus
     the trustInfo block that makes Windows show a UAC prompt and run the
     app elevated: creating the Wintun adapter, setting its address and
     adding routes all need administrator rights. Without this manifest
     the user had to remember "right-click → Run as administrator" every
     time; the installed app now elevates itself.

     Wired in build.rs via tauri_build::WindowsAttributes::app_manifest.
     The `compatibility` block opts the app into modern Windows behavior
     (no compatibility shims) on Windows 7 through 11. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity
    version="1.0.0.0"
    name="dev.rconpilot.nexlink"
    type="win32"
  />
  <description>NexLink — share your phone's internet with this PC.</description>
  <dependency>
    <dependentAssembly>
      <assemblyIdentity
        type="win32"
        name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0"
        processorArchitecture="*"
        publicKeyToken="6595b64144ccf1df"
        language="*"
      />
    </dependentAssembly>
  </dependency>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 11 / 10 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}" />
      <!-- Windows 8 -->
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}" />
      <!-- Windows 7 -->
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}" />
    </application>
  </compatibility>
</assembly>
